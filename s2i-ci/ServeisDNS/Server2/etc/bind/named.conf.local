// /etc/bind/named.conf.local

// Zona Principal
zone "isitech.org" {
    type master;
    file "/etc/bind/db.isitech.org";
    allow-transfer { 192.168.144.203; }; // Permet la transfer  ncia al DNS Secunda>
};

// Zona Delegada (Subdomini) - El teu "segon nom de domini"
zone "estacions.isitech.org" {
    type master;
    file "/etc/bind/db.estacions.isitech.org";
    allow-transfer { 192.168.144.203; };
};

// Zona Inversa per a la xarxa 10.18.30.0/24
// Nom de la zona: 30.18.10.in-addr.arpa
zone "30.18.10.in-addr.arpa" {
    type master;
    file "/etc/bind/db.10.18.30";
    allow-transfer { 192.168.144.203; };
