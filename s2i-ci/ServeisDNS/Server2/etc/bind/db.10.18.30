$TTL 1M  ; TTL per defecte d'1 minut

@ IN SOA ns01.isitech.org. admin.isitech.org. (
                2008052001 ; Serial
                2M         ; Refresh (2 minuts)
                1M         ; Retry (1 minut)
                1D         ; Expire (1 dia)
                1M )       ; Minimum TTL (1 minut)

; Registres NS
@               IN      NS      ns01.isitech.org.
@               IN      NS      ns2.isitech.org.

; Registres PTR
; Nom del registre =   ltim octet de la IP
168             IN      PTR     est01.estacions.isitech.org.
169             IN      PTR     est02.estacions.isitech.org.
170             IN      PTR     est03.estacions.isitech.org.
171             IN      PTR     est04.estacions.isitech.org.
172             IN      PTR     est05.estacions.isitech.org.
