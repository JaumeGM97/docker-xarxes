include "/etc/bind/keys/dhcp.key";

zone "isitech.com" {
    type master;
    file "/etc/bind/Isitech.com";
    allow-update { key dhcpupdate; };
};

zone "estacions.intranet.com" {
    type master;
    file "/etc/bind/estacions.intranet.com";
    allow-transfer { 192.168.144.196; };
};

zone "30.18.10.in-addr.arpa" {
    type master;
    file "/etc/bind/30.18.10.in-addr.arpa";
    allow-update { key dhcpupdate; };
};
